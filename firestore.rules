rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeMember() {
      return signedIn() && userRecord().data.status == "Active";
    }

    function linkedMember() {
      return activeMember() &&
        userRecord().data.linkedPlayerKey is string &&
        userRecord().data.linkedPlayerKey.size() > 0;
    }

    function admin() {
      return activeMember() && userRecord().data.role in ["admin", "owner"];
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == "Active" &&
        request.resource.data.role == "member";
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role;
      allow update, delete: if admin();
    }

    // Private player directory. Full names are visible only after sign-in.
    match /players/{playerId} {
      allow read: if activeMember();
      allow create: if linkedMember() || admin();
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId);
      allow delete: if admin();
    }

    // Public copy deliberately excludes fullName and other private fields.
    match /publicPlayers/{playerId} {
      allow read: if true;
      allow create: if linkedMember() || admin();
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId);
      allow delete: if admin();
    }

    match /linkedPlayers/{userId} {
      allow read: if activeMember();
      allow create, update: if activeMember() && request.auth.uid == userId &&
        request.resource.data.playerKey == userRecord().data.linkedPlayerKey;
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if admin();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if admin();
    }

    match /results/{resultId} {
      allow read: if true;
      allow create: if admin() ||
        (linkedMember() && request.resource.data.submittedBy == request.auth.uid);
      allow update: if admin() ||
        (linkedMember() && resource.data.submittedBy == request.auth.uid &&
          request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if admin();
    }

    match /fines/{fineId} {
      allow read: if true;
      allow write: if admin();
    }

    match /dartMatches/{matchId} {
      allow read: if activeMember();
      allow create: if activeMember() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if activeMember() &&
        resource.data.submittedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /votes/{voteId} {
      allow read: if admin() || (signedIn() && request.auth.uid == voteId);
      allow create: if linkedMember() && request.auth.uid == voteId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
