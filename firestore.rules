rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeMember() {
      return signedIn() && userRecord().data.status == "Active";
    }

    function linkedMember() {
      return activeMember() &&
        userRecord().data.linkedPlayerKey is string &&
        userRecord().data.linkedPlayerKey.size() > 0;
    }

    function admin() {
      return activeMember() && userRecord().data.role in ["admin", "owner"];
    }

    function owner() {
      return activeMember() && userRecord().data.role == "owner";
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == "Active" &&
        request.resource.data.role == "member" &&
        request.resource.data.get("accountType", "player") in ["player", "supporter"] &&
        request.resource.data.get("adminRequestStatus", "none") in ["none", "pending"] &&
        (request.resource.data.get("adminRequestStatus", "none") != "pending" ||
          request.resource.data.get("accountType", "player") == "player") &&
        !request.resource.data.keys().hasAny(["adminReviewedBy", "adminReviewedAt"]);
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["adminRequestStatus", "adminReviewedBy", "adminReviewedAt"]);
      allow update: if owner() ||
        (admin() && resource.data.role != "owner" &&
          request.resource.data.role == resource.data.role &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["adminRequestStatus", "adminReviewedBy", "adminReviewedAt"]));
      allow delete: if owner();
    }

    // Private player directory. Full names are visible only after sign-in.
    match /players/{playerId} {
      allow read: if activeMember();
      allow create: if admin() || (linkedMember() && !request.resource.data.keys().hasAny(["registrationPaidSeasons"]));
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["registrationPaidSeasons"]));
      allow delete: if admin();
    }

    // Public copy deliberately excludes fullName and other private fields.
    match /publicPlayers/{playerId} {
      allow read: if true;
      allow create: if admin() || (linkedMember() && !request.resource.data.keys().hasAny(["registrationPaidSeasons"]));
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["registrationPaidSeasons"]));
      allow delete: if admin();
    }

    match /linkedPlayers/{userId} {
      allow read: if activeMember();
      allow create, update: if activeMember() && request.auth.uid == userId &&
        request.resource.data.playerKey == userRecord().data.linkedPlayerKey;
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if admin();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if admin();
    }

    match /results/{resultId} {
      allow read: if true;
      allow create: if admin() ||
        (linkedMember() && request.resource.data.submittedBy == request.auth.uid);
      allow update: if admin() ||
        (linkedMember() && resource.data.submittedBy == request.auth.uid &&
          request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if admin();

      match /photos/{photoId} {
        allow read: if true;
        allow create: if activeMember() && exists(/databases/$(database)/documents/results/$(resultId)) &&
          request.resource.data.keys().hasOnly(["storagePath", "uploaderUid", "createdAt"]) &&
          request.resource.data.uploaderUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.storagePath == "result-photos/" + resultId + "/" + request.auth.uid + "/" + photoId;
        allow update: if false;
        allow delete: if admin() || (activeMember() && resource.data.uploaderUid == request.auth.uid);
      }
    }

    match /fines/{fineId} {
      allow read: if true;
      allow write: if admin();
    }

    // Fine payment records are financial administration data.
    match /finePayments/{paymentId} {
      allow read, write: if admin();
    }

    // Club cash book: administrators only. Expenses are voided, never deleted.
    match /clubBankSettings/{seasonId} {
      allow read: if admin();
      allow create, update: if admin() && seasonId == "26-27" &&
        request.resource.data.keys().hasOnly(["openingPence", "updatedAt", "updatedBy", "updatedByName"]) &&
        request.resource.data.openingPence is int && request.resource.data.openingPence >= -100000000 && request.resource.data.openingPence <= 100000000 &&
        request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedByName is string && request.resource.data.updatedByName.size() <= 200;
      allow delete: if false;
    }

    match /clubBankOpeningHistory/{entryId} {
      allow read: if admin();
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(["season", "openingPence", "createdAt", "createdBy", "createdByName"]) &&
        request.resource.data.season == "26-27" && request.resource.data.openingPence is int &&
        request.resource.data.openingPence >= -100000000 && request.resource.data.openingPence <= 100000000 &&
        request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 200;
      allow update, delete: if false;
    }

    match /clubBankEntries/{entryId} {
      allow read: if admin();
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(["season", "type", "date", "description", "amountPence", "voided", "createdBy", "createdByName", "createdAt"]) &&
        request.resource.data.season == "26-27" && request.resource.data.type in ["income", "expense"] &&
        request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 200 &&
        request.resource.data.amountPence is int && request.resource.data.amountPence > 0 && request.resource.data.amountPence <= 100000000 &&
        request.resource.data.voided == false && request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 200;
      allow update: if admin() && resource.data.voided == false && request.resource.data.voided == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["voided", "voidedAt", "voidedBy", "voidedByName"]) &&
        request.resource.data.voidedAt == request.time && request.resource.data.voidedBy == request.auth.uid &&
        request.resource.data.voidedByName is string && request.resource.data.voidedByName.size() <= 200;
      allow delete: if false;
    }

    // Versioned probe for the tournament form. The document does not need to exist.
    match /tournamentAccess/create-v1 {
      allow get: if admin();
    }

    match /{tournamentCollection}/{tournamentId} {
      function testTournament() {
        return tournamentCollection == "testTournaments";
      }

      function ownEntryChange() {
        let uid = request.auth.uid;
        let before = resource.data.entries;
        let after = request.resource.data.entries;
        let profile = userRecord().data;
        let linkedName = profile.get("linkedPlayerName", "");
        let name = linkedName == "" ? profile.get("firstName", "") : linkedName;
        return resource.data.status == "open" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entries"]) &&
          after is map && after.diff(before).affectedKeys().hasOnly([uid]) &&
          ((!before.keys().hasAny([uid]) && after.keys().hasAny([uid]) &&
            !resource.data.get("markers", {}).keys().hasAny([uid]) &&
            (resource.data.settings.get("playMode", "") == "inPerson" || after.size() <= resource.data.settings.capacity) &&
            name is string &&
            name.size() > 0 && name.size() <= 100 && after[uid] == name) ||
           (before.keys().hasAny([uid]) && !after.keys().hasAny([uid])));
      }

      function appendResult() {
        let before = resource.data.results;
        let after = request.resource.data.results;
        return after is map && after.size() == before.size() + 1 &&
          after.diff(before).affectedKeys().size() == 1;
      }

      function countdownFinished() {
        let settings = resource.data.settings;
        let delay = settings.get("startDelayMinutes", 0);
        return settings.get("playMode", "") != "online" || delay == 0 ||
          request.time >= resource.data.startedAt + duration.value(delay, "m");
      }

      function validLegCount(count, oddOnly) {
        return count is int && count >= 1 && count <= 19 && (!oddOnly || count % 2 == 1);
      }

      function tournamentRulesEdit() {
        let settings = request.resource.data.settings;
        let bestOf = settings.gameType == "bestOf";
        let groupOnly = settings.structure == "groups";
        let boards = settings.get("boardCount", 1);
        return resource.data.status in ["open", "live"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["settings"]) &&
          settings.diff(resource.data.settings).affectedKeys()
            .hasOnly(["boardCount", "gameType", "legsCount", "groupLegs", "quarterFinalLegs", "semiFinalLegs", "finalLegs", "firstThrow"]) &&
          (resource.data.status == "open" || !settings.diff(resource.data.settings).affectedKeys().hasAny(["firstThrow"])) &&
          settings.get("firstThrow", "bull") in ["bull", "coin", "random"] &&
          settings.gameType in ["bestOf", "firstTo"] &&
          (settings.get("playMode", "inPerson") == "online"
            ? !settings.keys().hasAny(["boardCount"])
            : (boards is int && boards >= 1 && boards <= 64)) &&
          validLegCount(settings.legsCount, bestOf && !groupOnly) &&
          (settings.structure == "knockout"
            ? !settings.keys().hasAny(["groupLegs"])
            : validLegCount(settings.get("groupLegs", settings.legsCount), false)) &&
          (groupOnly
            ? !settings.keys().hasAny(["quarterFinalLegs", "semiFinalLegs", "finalLegs"])
            : validLegCount(settings.get("quarterFinalLegs", settings.legsCount), bestOf) &&
              validLegCount(settings.get("semiFinalLegs", settings.legsCount), bestOf) &&
              validLegCount(settings.get("finalLegs", settings.legsCount), bestOf));
      }

      allow read: if tournamentCollection == "tournaments" || (testTournament() && admin());
      allow create: if (tournamentCollection == "tournaments" || testTournament()) && admin() &&
        request.resource.data.keys().hasOnly(["title", "settings", "createdBy", "createdAt", "status", "entries", "seeds", "results"]) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.status == "open" &&
        request.resource.data.settings.get("playMode", "inPerson") in ["online", "inPerson"] &&
        request.resource.data.settings.get("firstThrow", "bull") in ["bull", "coin", "random"] &&
        (request.resource.data.settings.get("playMode", "inPerson") == "online"
          ? (request.resource.data.settings.get("startDelayMinutes", 0) is int &&
            request.resource.data.settings.get("startDelayMinutes", 0) >= 0 &&
            request.resource.data.settings.get("startDelayMinutes", 0) <= 60)
          : !request.resource.data.settings.keys().hasAny(["startDelayMinutes"])) &&
        (request.resource.data.settings.get("playMode", "inPerson") == "online"
          ? !request.resource.data.settings.keys().hasAny(["boardCount"])
          : (request.resource.data.settings.get("boardCount", 1) is int &&
            request.resource.data.settings.get("boardCount", 1) >= 1 &&
            request.resource.data.settings.get("boardCount", 1) <= 64)) &&
        ((request.resource.data.settings.get("playMode", "") == "inPerson" && request.resource.data.settings.capacity == null) ||
          (request.resource.data.settings.capacity is int && request.resource.data.settings.capacity >= 4 &&
            request.resource.data.settings.capacity <= 128)) &&
        (request.resource.data.settings.get("plate", false) == false ||
          (request.resource.data.settings.plate == true && request.resource.data.settings.structure == "combined")) &&
        (testTournament()
          ? (request.resource.data.entries is map && request.resource.data.entries.size() >= 3 &&
            request.resource.data.entries.size() <= (request.resource.data.settings.get("playMode", "") == "inPerson"
              ? 512 : request.resource.data.settings.capacity))
          : request.resource.data.entries == {}) &&
        request.resource.data.seeds == {} && request.resource.data.results == {};
      allow update: if (tournamentCollection == "tournaments" && activeMember() && ownEntryChange()) ||
        (testTournament() && admin() && ownEntryChange()) ||
        ((tournamentCollection == "tournaments" || testTournament()) && admin() && (
          tournamentRulesEdit() ||
          (resource.data.status == "live" && resource.data.settings.get("playMode", "inPerson") == "inPerson" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeMatches"]) &&
            request.resource.data.activeMatches is map &&
            request.resource.data.activeMatches.diff(resource.data.get("activeMatches", {})).affectedKeys().size() == 1) ||
          (resource.data.status == "open" && request.resource.data.status == "live" &&
            request.resource.data.startedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["draw", "seeds", "status", "startedAt"])) ||
          (resource.data.status == "live" && request.resource.data.status == "live" && countdownFinished() && appendResult() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["results"])) ||
          (resource.data.status == "live" && request.resource.data.status == "complete" && countdownFinished() && appendResult() &&
            request.resource.data.completedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["results", "status", "completedAt"]))
        ));
      match /scoring/{fixtureId} {
        allow get: if activeMember() && (tournamentCollection == "tournaments" || (testTournament() && admin())) &&
          (resource.data.mode == "shared" ? request.auth.uid in resource.data.players : request.auth.uid == resource.data.owner);
      }

      allow delete: if (tournamentCollection == "tournaments" || testTournament()) &&
        admin() && resource.data.createdBy == request.auth.uid;
    }

    match /dartMatches/{matchId} {
      allow read: if activeMember();
      allow create: if activeMember() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if activeMember() &&
        resource.data.submittedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /votes/{voteId} {
      allow read: if admin() || (signedIn() && request.auth.uid == voteId);
      allow create: if linkedMember() && request.auth.uid == voteId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
