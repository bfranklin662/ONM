rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeMember() {
      return signedIn() && userRecord().data.status == "Active";
    }

    function linkedMember() {
      return activeMember() &&
        userRecord().data.linkedPlayerKey is string &&
        userRecord().data.linkedPlayerKey.size() > 0;
    }

    function admin() {
      return activeMember() && userRecord().data.role in ["admin", "owner"];
    }

    function owner() {
      return activeMember() && userRecord().data.role == "owner";
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == "Active" &&
        request.resource.data.role == "member" &&
        request.resource.data.get("accountType", "player") in ["player", "supporter"] &&
        request.resource.data.get("adminRequestStatus", "none") in ["none", "pending"] &&
        (request.resource.data.get("adminRequestStatus", "none") != "pending" ||
          request.resource.data.get("accountType", "player") == "player") &&
        !request.resource.data.keys().hasAny(["adminReviewedBy", "adminReviewedAt"]);
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role == resource.data.role &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["adminRequestStatus", "adminReviewedBy", "adminReviewedAt"]);
      allow update: if owner() ||
        (admin() && resource.data.role != "owner" &&
          request.resource.data.role == resource.data.role &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["adminRequestStatus", "adminReviewedBy", "adminReviewedAt"]));
      allow delete: if owner();
    }

    // Private player directory. Full names are visible only after sign-in.
    match /players/{playerId} {
      allow read: if activeMember();
      allow create: if admin() || (linkedMember() && !request.resource.data.keys().hasAny(["registrationPaidSeasons"]));
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["registrationPaidSeasons"]));
      allow delete: if admin();
    }

    // Public copy deliberately excludes fullName and other private fields.
    match /publicPlayers/{playerId} {
      allow read: if true;
      allow create: if admin() || (linkedMember() && !request.resource.data.keys().hasAny(["registrationPaidSeasons"]));
      allow update: if admin() ||
        (activeMember() && userRecord().data.linkedPlayerKey == playerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["registrationPaidSeasons"]));
      allow delete: if admin();
    }

    match /linkedPlayers/{userId} {
      allow read: if activeMember();
      allow create, update: if activeMember() && request.auth.uid == userId &&
        request.resource.data.playerKey == userRecord().data.linkedPlayerKey;
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if admin();
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if admin();
    }

    match /results/{resultId} {
      allow read: if true;
      allow create: if admin() ||
        (linkedMember() && request.resource.data.submittedBy == request.auth.uid);
      allow update: if admin() ||
        (linkedMember() && resource.data.submittedBy == request.auth.uid &&
          request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if admin();

      match /photos/{photoId} {
        allow read: if true;
        allow create: if activeMember() && exists(/databases/$(database)/documents/results/$(resultId)) &&
          request.resource.data.keys().hasOnly(["storagePath", "uploaderUid", "createdAt"]) &&
          request.resource.data.uploaderUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.storagePath == "result-photos/" + resultId + "/" + request.auth.uid + "/" + photoId;
        allow update: if false;
        allow delete: if admin() || (activeMember() && resource.data.uploaderUid == request.auth.uid);
      }
    }

    match /fines/{fineId} {
      allow read: if true;
      allow write: if admin();
    }

    // Fine payment records are financial administration data.
    match /finePayments/{paymentId} {
      allow read, write: if admin();
    }

    // Club cash book: administrators only. Expenses are voided, never deleted.
    match /clubBankSettings/{seasonId} {
      allow read: if admin();
      allow create, update: if admin() && seasonId == "26-27" &&
        request.resource.data.keys().hasOnly(["openingPence", "updatedAt", "updatedBy", "updatedByName"]) &&
        request.resource.data.openingPence is int && request.resource.data.openingPence >= -100000000 && request.resource.data.openingPence <= 100000000 &&
        request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedByName is string && request.resource.data.updatedByName.size() <= 200;
      allow delete: if false;
    }

    match /clubBankOpeningHistory/{entryId} {
      allow read: if admin();
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(["season", "openingPence", "createdAt", "createdBy", "createdByName"]) &&
        request.resource.data.season == "26-27" && request.resource.data.openingPence is int &&
        request.resource.data.openingPence >= -100000000 && request.resource.data.openingPence <= 100000000 &&
        request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 200;
      allow update, delete: if false;
    }

    match /clubBankEntries/{entryId} {
      allow read: if admin();
      allow create: if admin() &&
        request.resource.data.keys().hasOnly(["season", "type", "date", "description", "amountPence", "voided", "createdBy", "createdByName", "createdAt"]) &&
        request.resource.data.season == "26-27" && request.resource.data.type in ["income", "expense"] &&
        request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 200 &&
        request.resource.data.amountPence is int && request.resource.data.amountPence > 0 && request.resource.data.amountPence <= 100000000 &&
        request.resource.data.voided == false && request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 200;
      allow update: if admin() && resource.data.voided == false && request.resource.data.voided == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["voided", "voidedAt", "voidedBy", "voidedByName"]) &&
        request.resource.data.voidedAt == request.time && request.resource.data.voidedBy == request.auth.uid &&
        request.resource.data.voidedByName is string && request.resource.data.voidedByName.size() <= 200;
      allow delete: if false;
    }

    match /dartMatches/{matchId} {
      allow read: if activeMember();
      allow create: if activeMember() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if activeMember() &&
        resource.data.submittedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /votes/{voteId} {
      allow read: if admin() || (signedIn() && request.auth.uid == voteId);
      allow create: if linkedMember() && request.auth.uid == voteId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
